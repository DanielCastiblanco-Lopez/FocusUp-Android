<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema principal de FocusUp con tipografia Poppins aplicada globalmente -->
    <style name="Theme.FocusUp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#18BC9C</item>
        <item name="colorPrimaryDark">#2C3E50</item>
        <item name="colorAccent">#18BC9C</item>
        <item name="android:windowBackground">#ECF0F1</item>

        <!-- Tipografia: Poppins en toda la app -->
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="materialButtonStyle">@style/Widget.FocusUp.Button</item>
        <item name="textInputStyle">@style/Widget.FocusUp.TextInputLayout</item>
    </style>

    <!-- Boton con esquinas redondeadas unificadas y tipografia semibold -->
    <style name="Widget.FocusUp.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Campos de texto con esquinas redondeadas unificadas -->
    <style name="Widget.FocusUp.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- Estilo unificado para CardView: esquinas y elevacion consistentes en toda la app -->
    <style name="Widget.FocusUp.CardView" parent="CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">#FFFFFF</item>
    </style>

    <!-- Titulo del Toolbar: Poppins Bold, color azul oscuro sobre fondo blanco -->
    <style name="TextAppearance.FocusUp.Toolbar" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#2C3E50</item>
    </style>

</resources>
