<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    android:outlineProvider="background"
    android:clipToOutline="true"
    app:cardElevation="0dp"
        android:elevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Encabezado con el dia seleccionado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2C3E50"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvDayDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jueves, 12 de junio"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDayDialogSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2 tareas"
                android:textColor="#A6B1B9"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Contenido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Mensaje cuando no hay tareas ese dia -->
            <LinearLayout
                android:id="@+id/containerNoTasksDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="10dp"
                    android:alpha="0.4"
                    android:contentDescription="Sin tareas"
                    android:src="@drawable/ic_tasks"
                    app:tint="#7F8C8D" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No tienes tareas para este dia"
                    android:textColor="#7F8C8D"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Contenedor dinamico de tareas del dia -->
            <LinearLayout
                android:id="@+id/containerDayTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseDayDialog"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="Cerrar"
                    android:textColor="#7F8C8D"
                    app:cornerRadius="14dp"
                    app:strokeColor="#D5DBDB"
                    app:strokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeeAllTasks"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Ver todas"
                    android:textStyle="bold"
                    app:backgroundTint="#18BC9C"
                    app:cornerRadius="14dp" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
