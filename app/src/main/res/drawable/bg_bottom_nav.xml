<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del BottomNavigationView: blanco con esquinas redondeadas arriba
     y sombra suave, para un look moderno tipo "floating pill" -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sombra que respeta las esquinas redondeadas -->
    <item
        android:top="3dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#12000000" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>
    <!-- Fondo blanco real -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
