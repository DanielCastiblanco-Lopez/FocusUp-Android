<?xml version="1.0" encoding="utf-8"?>
<!-- Sombra que respeta el border-radius usando layer-list.
     Se usa como background del contenedor PADRE del CardView,
     no en el CardView mismo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa de sombra desplazada hacia abajo -->
    <item
        android:top="3dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#18000000"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <!-- Fondo blanco encima -->
    <item
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
